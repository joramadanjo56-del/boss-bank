{
  "name": "@boss-bank/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @boss-bank/shared && npm run build --workspace @boss-bank/db",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://boss_bank:boss_bank@localhost:5432/boss_bank_test?schema=public} tsx --test test/*.test.ts",
    "admin:promote": "tsx src/promote-admin.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@boss-bank/db": "*",
    "@boss-bank/shared": "*",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4"
  }
}
